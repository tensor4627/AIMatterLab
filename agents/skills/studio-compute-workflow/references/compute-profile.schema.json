{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Studio compute overlay input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "transport",
    "connection_ref",
    "scheduler",
    "environments",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "transport": {
      "enum": [
        "ssh",
        "local-wsl"
      ]
    },
    "connection_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "scheduler": {
      "enum": [
        "lsf",
        "slurm",
        "local"
      ]
    },
    "queue": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,127}$"
    },
    "run_root": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1024,
      "description": "Private absolute target Linux path, metadata only; traversal and control characters are rejected."
    },
    "lsf_memory_scope": {
      "enum": [
        "per_slot",
        "per_job"
      ]
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "engines",
          "version",
          "executables"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "engines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 14,
            "uniqueItems": true,
            "items": {
              "enum": [
                "gpumd.md",
                "pydyn.md",
                "gpumd.sampling",
                "pydyn.sampling",
                "pygas.build",
                "bias.validate",
                "nep.train",
                "nep.eval",
                "nep.analyze",
                "hotpp.train",
                "hotpp.eval",
                "hotpp.export",
                "pygas.reweight",
                "pygas.opes-reweight"
              ]
            }
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "executables": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "python": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024,
                "description": "Private absolute target Linux path, metadata only; traversal and control characters are rejected."
              },
              "gpumd": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024,
                "description": "Private absolute target Linux path, metadata only; traversal and control characters are rejected."
              },
              "nep": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024,
                "description": "Private absolute target Linux path, metadata only; traversal and control characters are rejected."
              },
              "hotpp": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024,
                "description": "Private absolute target Linux path, metadata only; traversal and control characters are rejected."
              },
              "pygas": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024,
                "description": "Private absolute target Linux path, metadata only; traversal and control characters are rejected."
              },
              "gpu-sampling": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024,
                "description": "Private absolute target Linux path, metadata only; traversal and control characters are rejected."
              }
            },
            "minProperties": 1
          },
          "repositories": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pydyn": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024,
                "description": "Private absolute target Linux path, metadata only; traversal and control characters are rejected."
              },
              "pygas": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024,
                "description": "Private absolute target Linux path, metadata only; traversal and control characters are rejected."
              },
              "gpumd": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024,
                "description": "Private absolute target Linux path, metadata only; traversal and control characters are rejected."
              },
              "hotpp": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024,
                "description": "Private absolute target Linux path, metadata only; traversal and control characters are rejected."
              },
              "torchnep": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024,
                "description": "Private absolute target Linux path, metadata only; traversal and control characters are rejected."
              }
            },
            "minProperties": 1
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpus",
        "gpus",
        "memory_mb",
        "max_seconds"
      ],
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "gpus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        }
      }
    },
    "local_skill_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 1024,
        "description": "Explicit local absolute SKILL.md reference; never read or copied by this helper."
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transport": {
            "const": "ssh"
          }
        }
      },
      "then": {
        "properties": {
          "scheduler": {
            "enum": [
              "lsf",
              "slurm"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "scheduler": {
            "const": "local"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scheduler": {
            "const": "local"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "queue"
              ]
            },
            {
              "required": [
                "lsf_memory_scope"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "scheduler": {
            "enum": [
              "local",
              "slurm"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "lsf_memory_scope"
          ]
        }
      }
    }
  ]
}
