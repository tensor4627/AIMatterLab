  "inputs":["structure","model","control"],
  "steps":[
    {"id":"report","tool":"example.report","label":"汇总分析","inputs":[{"port":"msd","resource":"msd"},{"port":"rdf","resource":"rdf"}],"outputs":[{"port":"report","resource":"report"}]},
