{
  "schema_version": 1,
  "resources": [
    {"id":"structure","label":"初始结构","format":"extxyz","field":"structure_file","basis":"user"},
    {"id":"model","label":"势模型","field":"potential_file","basis":"user"},
    {"id":"control","label":"模拟参数","field":"control_file","basis":"user"},
    {"id":"frames","label":"MD 轨迹","format":"extxyz","basis":"user"},
    {"id":"thermo","label":"热力学序列","basis":"inferred","requirements":["温度（K）和总能量（eV）","采样间隔 0.1 ps"]},
    {"id":"msd","label":"均方位移"},
    {"id":"rdf","label":"径向分布"},
