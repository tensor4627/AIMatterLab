{
  "type": "object",
  "required": ["task_id", "name", "steps", "parameters", "missing_fields"],
  "additionalProperties": false,
  "properties": {
    "task_id": {"type": "string"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "steps": {
      "type": "array",
      "maxItems": 80,
      "items": {"anyOf": [
        {"type": "string"},
        {
          "type": "object",
          "required": ["id", "title", "fields"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "title": {"type": "string", "minLength": 1},
            "description": {"type": "string"},
            "tool": {"type": "string"},
            "optional": {"type": "boolean"},
            "fields": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": ["key", "label", "type", "required"],
                "additionalProperties": false,
                "properties": {
                  "key": {"type": "string"},
                  "label": {"type": "string", "minLength": 1},
                  "type": {"type": "string", "enum": ["text", "number", "integer", "boolean", "file", "files", "list", "object", "select", "multiline"]},
                  "required": {"type": "boolean"},
                  "advanced": {"type": "boolean"},
                  "default": {"type": ["string", "number", "boolean", "null"]},
                  "default_source": {"type": "string", "maxLength": 2000},
                  "unit": {"type": "string", "maxLength": 40},
                  "description": {"type": "string", "maxLength": 2000},
                  "options": {"type": "array", "maxItems": 100, "items": {"type": "string"}}
                }
              }
            }
          }
        }
      ]}
    },
    "parameters": {"type": "object"},
    "missing_fields": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
  }
}
