{
  "name": "aimatterlab",
  "productName": "AIMatterLab",
  "version": "0.1.31",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "source": "node scripts/source-start.mjs",
    "dev": "node scripts/stage-agents.mjs && node scripts/build-cli-installer.mjs && node scripts/sync-tool-contracts.mjs --check && node scripts/dev.mjs",
    "build": "node scripts/sync-tool-contracts.mjs && tsc --noEmit && vite build && node scripts/build-cli-installer.mjs && node scripts/stage-agents.mjs",
    "start": "node scripts/stage-agents.mjs && node scripts/build-cli-installer.mjs && node scripts/sync-tool-contracts.mjs --check && node scripts/start.mjs",
    "check:skills": "node scripts/check-bundled-guidance.mjs --source",
    "check:contracts": "node scripts/sync-tool-contracts.mjs --check",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:package-runtime": "node scripts/package-runtime.mjs --validate",
    "test": "node scripts/test-node.mjs",
    "test:worker": "node scripts/test-worker.mjs",
    "test:frontend": "node scripts/frontend-regression.mjs",
    "test:frontend:recovery": "node scripts/frontend-source-recovery.mjs",
    "protocol": "node scripts/protocol.mjs",
    "pack": "pnpm run build && electron-builder --win nsis zip --x64 --publish never --config.electronDist=node_modules/electron/dist && node scripts/package-companions.mjs",
    "stage:agents": "node scripts/stage-agents.mjs",
    "test:task": "node scripts/task-integration-smoke.mjs",
    "test:pygas-ui": "node scripts/pygas-composer-regression.mjs",
    "test:pygas-order": "node scripts/pygas-reorder-regression.mjs",
    "test:frontend:compute": "node scripts/frontend-compute-receipts.mjs",
    "test:frontend:commands": "node scripts/frontend-conversation-commands.mjs",
    "check:cli-runtime-lock": "node scripts/generate-cli-runtime-lock.mjs --check"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "echarts": "5.6.0",
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "monaco-editor": "0.52.2",
    "pdfjs-dist": "6.5.438",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "0.172.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sdk-minimal": "0.2.2-rc.1",
    "@lydell/node-pty": "1.2.0-beta.10",
    "@moonshot-ai/kimi-code": "2.1.1",
    "@qwen-code/qwen-code": "0.24.7",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@types/three": "0.172.0",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.65.0",
    "tar": "7.5.22",
    "typescript": "5.7.3",
    "vite": "6.4.1"
  },
  "build": {
    "appId": "science.gpusampling.studio",
    "productName": "AIMatterLab",
    "beforeBuild": "scripts/package-runtime.mjs",
    "afterPack": "scripts/workspace-installer-files.mjs",
    "directories": {
      "output": "release/v0.1.31"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "!desktop/generated/**/*.ts",
      "backend/main/**",
      "agent/**",
      "!agent/builtin-skills/**",
      "contracts/**",
      "!contracts/dto/**",
      "!contracts/**/*.d.mts",
      {
        "from": "backend/worker",
        "to": "worker",
        "filter": [
          "**/*",
          "!tests/**",
          "!**/__pycache__/**"
        ]
      },
      "package.json",
      "!node_modules/**/*",
      "!**/__pycache__/**",
      "!**/*.pyc"
    ],
    "asarUnpack": [
      "**/worker/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "sign": "scripts/sign-windows-setup.mjs",
        "signingHashAlgorithms": ["sha256"]
      },
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "AIMatterLab-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "createDesktopShortcut": "always",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "installerLanguages": ["en_US", "zh_CN"],
      "include": "build/workspace-installer.nsh",
      "artifactName": "AIMatterLab-${version}-win-${arch}-setup.${ext}"
    },
    "extraResources": [
      {
        "from": "installation/tool-sources.json",
        "to": "tool-sources.json"
      },
      {
        "from": "desktop/platform/terminal-service",
        "to": "terminal-service",
        "filter": [
          "**/*.mjs",
          "**/*.py"
        ]
      },
      {
        "from": ".studio/agent-runtimes/node_modules",
        "to": "agent-runtimes/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".studio/agent-runtimes/manifest.json",
        "to": "agent-runtimes/manifest.json"
      },
      {
        "from": ".studio/agent-runtimes/dsh/runtime.json",
        "to": "agent-runtimes/dsh/runtime.json"
      },
      {
        "from": ".studio/agent-runtimes/dsh/node_modules",
        "to": "agent-runtimes/dsh/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "agent/providers/dsh-policy.mjs",
        "to": "studio-dsh/dsh-policy.mjs"
      },
      {
        "from": "agent/builtin-skills",
        "to": "studio-skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts/localize-skill.mjs",
        "to": "studio-tools/localize-skill.mjs"
      },
      {
        "from": "scripts/cluster-reconcile.mjs",
        "to": "studio-tools/cluster-reconcile.mjs"
      }
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ]
  },
  "description": "Scientific workspace for agent-assisted workflows and third-party tools",
  "author": "AIMatterLab"
}
